# Environment configuration example for sports-analytics-local.
# Copy to `.env` for local use. Do not commit real secrets.
#
# Operating-system environment variables override values from this file.
# Nested settings use a double underscore after the SPORTS_ANALYTICS_ prefix.

# Optional path to a TOML settings file (control variable, not a model field)
# SPORTS_ANALYTICS_CONFIG_PATH=config/settings.toml

SPORTS_ANALYTICS_APPLICATION__ENVIRONMENT=development
SPORTS_ANALYTICS_APPLICATION__TIMEZONE=UTC
SPORTS_ANALYTICS_LOGGING__LEVEL=INFO
SPORTS_ANALYTICS_WORKER__POLL_INTERVAL_SECONDS=30
SPORTS_ANALYTICS_WORKER__HEARTBEAT_INTERVAL_SECONDS=15
SPORTS_ANALYTICS_WORKER__STALE_JOB_TIMEOUT_SECONDS=300
SPORTS_ANALYTICS_WORKER__RETRY_BACKOFF_BASE_SECONDS=5
SPORTS_ANALYTICS_WORKER__RETRY_BACKOFF_MAX_SECONDS=300
SPORTS_ANALYTICS_WORKER__SHUTDOWN_GRACE_SECONDS=30
SPORTS_ANALYTICS_WORKER__RECOVERY_BATCH_SIZE=100
SPORTS_ANALYTICS_SCRAPING__ENABLED=false
SPORTS_ANALYTICS_SCRAPING__REQUEST_TIMEOUT_SECONDS=30
SPORTS_ANALYTICS_SCRAPING__MAXIMUM_RETRIES=3
SPORTS_ANALYTICS_SCRAPING__RETRY_BACKOFF_BASE_SECONDS=2
SPORTS_ANALYTICS_SCRAPING__RETRY_BACKOFF_MAX_SECONDS=30
SPORTS_ANALYTICS_SCRAPING__MINIMUM_REQUEST_INTERVAL_SECONDS=2
SPORTS_ANALYTICS_SCRAPING__MAXIMUM_DOWNLOAD_BYTES=26214400
SPORTS_ANALYTICS_BOOKMAKERS__ENABLED=false
SPORTS_ANALYTICS_BOOKMAKERS__PREFERRED_PROVIDER=betano-pt
SPORTS_ANALYTICS_BOOKMAKERS__COMPARISON_PROVIDER=betclic-pt
SPORTS_ANALYTICS_BOOKMAKERS__SELECTION_MODE=preferred-unless-better
SPORTS_ANALYTICS_BOOKMAKERS__BROWSER_MODE=headless
SPORTS_ANALYTICS_BOOKMAKERS__QUOTE_MAXIMUM_AGE_SECONDS=300
SPORTS_ANALYTICS_BOOKMAKERS__DEFAULT_WINDOW_HOURS=48
SPORTS_ANALYTICS_BOOKMAKERS__MAXIMUM_WINDOW_HOURS=168
SPORTS_ANALYTICS_BOOKMAKERS__MAXIMUM_EVENTS_PER_SPORT=100
SPORTS_ANALYTICS_BOOKMAKERS__MARKET_DEPTH=all-observed-markets
SPORTS_ANALYTICS_BOOKMAKERS__MAXIMUM_RESPONSE_BYTES=2097152
SPORTS_ANALYTICS_BOOKMAKERS__MAXIMUM_TOTAL_CAPTURE_BYTES=16777216
SPORTS_ANALYTICS_BOOKMAKERS__EVENT_DETAIL_CONCURRENCY=1
SPORTS_ANALYTICS_BOOKMAKERS__MINIMUM_EVENT_DETAIL_INTERVAL_MS=1000
SPORTS_ANALYTICS_BOOKMAKERS__NAVIGATION_TIMEOUT_MS=30000
SPORTS_ANALYTICS_BOOKMAKERS__EXPLICIT_RETRY_LIMIT=0
SPORTS_ANALYTICS_BOOKMAKERS__BETANO__ENABLED=true
SPORTS_ANALYTICS_BOOKMAKERS__BETANO__ACQUISITION_INTERVAL_SECONDS=300
SPORTS_ANALYTICS_BOOKMAKERS__BETANO__INITIAL_DELAY_SECONDS=30
SPORTS_ANALYTICS_BOOKMAKERS__BETANO__BLOCKED_COOLDOWN_SECONDS=900
SPORTS_ANALYTICS_BOOKMAKERS__BETCLIC__ENABLED=true
SPORTS_ANALYTICS_BOOKMAKERS__BETCLIC__ACQUISITION_INTERVAL_SECONDS=300
SPORTS_ANALYTICS_BOOKMAKERS__BETCLIC__INITIAL_DELAY_SECONDS=45
SPORTS_ANALYTICS_BOOKMAKERS__BETCLIC__BLOCKED_COOLDOWN_SECONDS=900
