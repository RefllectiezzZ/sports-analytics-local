# Environment configuration example for sports-analytics-local.
# Copy to `.env` for local use. Do not commit real secrets.
#
# Operating-system environment variables override values from this file.
# Nested settings use a double underscore after the SPORTS_ANALYTICS_ prefix.

# Optional path to a TOML settings file (control variable, not a model field)
# SPORTS_ANALYTICS_CONFIG_PATH=config/settings.toml

SPORTS_ANALYTICS_APPLICATION__ENVIRONMENT=development
SPORTS_ANALYTICS_APPLICATION__TIMEZONE=UTC
SPORTS_ANALYTICS_LOGGING__LEVEL=INFO
SPORTS_ANALYTICS_WORKER__POLL_INTERVAL_SECONDS=30
